# ==============================================================================
# Open-Source AI Customer Service Platform - Environment Configuration Example
# ==============================================================================

# Node Environment ('development' or 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_dev_password
POSTGRES_DB=ai_customer_service
# Full connection string used by API and migration runners:
DATABASE_URL=postgresql://postgres:postgres_secure_dev_password@localhost:5432/ai_customer_service

# ------------------------------------------------------------------------------
# 2. Cryptography & Security Secrets
# ------------------------------------------------------------------------------
# Master key used for AES-256-GCM authenticated encryption of BYOK credentials.
# CRITICAL: In production, generate a secure random 32-byte string:
# openssl rand -hex 32
ENCRYPTION_MASTER_KEY=default-change-me-master-key-32bytes-long!

# JWT Secret used for signing admin and agent session tokens:
# openssl rand -base64 32
JWT_SECRET=default-change-me-jwt-secret-for-production!

# Allowed CORS origins for the API server:
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Ports & Service URLs
# ------------------------------------------------------------------------------
API_PORT=3001
WEB_PORT=3000
INTERNAL_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ------------------------------------------------------------------------------
# 4. Optional Bring-Your-Own-Key (BYOK) Default Providers (Placeholder examples)
# Note: Providers can also be securely added per-tenant inside the Web Console.
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-placeholder-example-do-not-commit-real-keys
# ANTHROPIC_API_KEY=sk-ant-placeholder-example
# GEMINI_API_KEY=AIza-placeholder-example
# GROQ_API_KEY=gsk_placeholder-example
# TWILIO_ACCOUNT_SID=ACplaceholder
# TWILIO_AUTH_TOKEN=placeholder
